# Variables de una instancia de cliente. Copia a .env y rellena.

# Identificador corto y sin espacios; nombra los contenedores y el proyecto.
TENANT_SLUG=soleil

# Nombre visible de la guarderia (aparece en la web y en la API).
TENANT_NAME=Guarderia Soleil

# Base de datos propia dentro del Postgres compartido.
# Hay que crearla antes: CREATE DATABASE kidcare_soleil;
DB_NAME=kidcare_soleil

# Subdominio publico que enruta el tunel de Cloudflare.
SUBDOMAIN=soleil

# Debe coincidir con la de deployments/postgres/.env
POSTGRES_ADMIN_PASSWORD=

# Secreto propio de este cliente. Generalo con:
#   openssl rand -base64 48
# Rotarlo invalida TODOS los tokens existentes de golpe.
JWT_SECRET=

# Opcionales, con defaults razonables si no los tocas (ver apps/api/src/env.ts):
#   JWT_TTL_DAYS=7            # duracion de la sesion
#   LOGIN_MAX_PER_IP=40       # limite de /auth/login por IP cada 15 min
#   LOGIN_MAX_PER_EMAIL=5     # limite de /auth/login por email cada 15 min
# COOKIE_SECURE no hace falta definirlo: la imagen ya corre con
# NODE_ENV=production, asi que la cookie de sesion es httpOnly+Secure sola.

# Opcionales, para Web Push (protocolo estandar del navegador, sin Firebase).
# Sin ellas la API arranca igual y solo desactiva el envio de push; genera un
# par propio con `bunx web-push generate-vapid-keys` (uno para TODA la
# instancia, no por cliente, aunque cada cliente puede tener el suyo si
# prefieres aislarlos).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tudominio.com
