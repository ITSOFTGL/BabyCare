# ---------------------------------------------------------------------------
# KidCare - variables para desarrollo local (docker-compose.dev.yml)
# Copia este archivo a .env y ajusta lo que necesites.
# ---------------------------------------------------------------------------

# Nombre de la guarderia que se muestra en la UI
TENANT_NAME=Guarderia Demo

# Postgres local de desarrollo
POSTGRES_USER=kidcare
POSTGRES_PASSWORD=kidcare_dev
POSTGRES_DB=kidcare_dev
POSTGRES_PORT=5433

# Cadena de conexion usada por la API dentro de la red de docker
DATABASE_URL=postgres://kidcare:kidcare_dev@postgres:5432/kidcare_dev

# Secreto para firmar los JWT (cambialo en produccion, minimo 32 caracteres).
# Rotarlo invalida TODOS los tokens existentes de golpe.
JWT_SECRET=dev-secret-cambiar-en-produccion-1234567890

# Cuantos dias dura la sesion antes de tener que volver a iniciar sesion.
JWT_TTL_DAYS=7

# Cookie httpOnly de sesion: solo desactivar 'secure' si NO hay HTTPS
# (por ejemplo, en desarrollo local sin certificado).
COOKIE_SECURE=false

# Limites de /auth/login en 15 minutos. El de IP es generoso porque varias
# profesoras de la misma guarderia suelen compartir la misma IP publica.
LOGIN_MAX_PER_IP=40
LOGIN_MAX_PER_EMAIL=5

# Puertos publicados en el host
API_PORT=3001
WEB_PORT=3000

# URL de la API que consume el navegador. API_URL/TENANT_NAME (sin prefijo)
# son los que de verdad lee el frontend en runtime; los NEXT_PUBLIC_* quedan
# de respaldo si algo corre fuera de Docker.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Credenciales del usuario directora creado por `bun run db:seed`
SEED_ADMIN_EMAIL=directora@kidcare.test
SEED_ADMIN_PASSWORD=Directora123!
